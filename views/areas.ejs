<%- include('partials/header') %>
<!-- Administracion de areas deportivas. Permite crear, renombrar, deshabilitar y rehabilitar areas. -->
<main class="w-full flex flex-col items-center justify-start p-4 md:p-8">
    <section class="w-full max-w-5xl bg-gray-900 border border-gray-700 rounded-lg shadow-lg p-5 md:p-8">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-white">Gestionar Areas</h1>
                <p class="text-gray-300 mt-1">Agregue, edite o deshabilite las areas disponibles para registrar visitas.</p>
            </div>
            <a href="/admin" class="bg-gray-700 text-white px-4 py-2 rounded hover:bg-gray-600 text-center">Volver</a>
        </div>

        <!-- Formulario para agregar una nueva area al catalogo. -->
        <form action="/admin/areas" method="post" class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-3 mb-8">
            <label class="sr-only" for="nombrearea">Nombre del area</label>
            <input
                id="nombrearea"
                name="nombrearea"
                type="text"
                placeholder="Nombre del area"
                class="w-full rounded border border-gray-600 bg-gray-800 text-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-600"
                required
            >
            <button type="submit" class="bg-blue-600 text-white px-5 py-3 rounded font-semibold hover:bg-blue-700">
                Agregar
            </button>
        </form>

        <!-- Tabla editable con las areas existentes. Las areas inactivas se muestran atenuadas pero disponibles para rehabilitar -->
        <div class="overflow-x-auto border border-gray-700 rounded-lg">
            <table class="w-full min-w-[640px] border-collapse">
                <thead class="bg-gray-800 text-white">
                    <tr>
                        <th class="text-left px-4 py-3">ID</th>
                        <th class="text-left px-4 py-3">Area</th>
                        <th class="text-left px-4 py-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (areas.length === 0) { %>
                        <tr>
                            <td colspan="3" class="px-4 py-6 text-center text-gray-300">No hay areas registradas.</td>
                        </tr>
                    <% } %>

                    <% areas.forEach(area => { %>
                        <tr class="border-t border-gray-700 <%= !area.activo ? 'bg-gray-800 opacity-60' : '' %>">
                            <td class="px-4 py-3 text-gray-200"><%= area.idareas %></td>
                            <td class="px-4 py-3">
                                <form id="editar-area-<%= area.idareas %>" action="/admin/areas/<%= area.idareas %>/editar" method="post">
                                    <input
                                        name="nombrearea"
                                        type="text"
                                        value="<%= area.nombrearea %>"
                                        <%= !area.activo ? 'disabled' : '' %>
                                        class="w-full rounded border border-gray-600 bg-gray-800 text-white px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-600 <%= !area.activo ? 'opacity-50 cursor-not-allowed' : '' %>"
                                        required
                                    >
                                </form>
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex flex-col sm:flex-row gap-2">
                                    <% if (area.activo) { %>
                                        <button form="editar-area-<%= area.idareas %>" type="submit" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
                                            Guardar
                                        </button>
                                        <form action="/admin/areas/<%= area.idareas %>/eliminar" method="post" onsubmit="return confirm('Desea deshabilitar esta area? Dejaria de aparecer en los listados de registro.');">
                                            <button type="submit" class="w-full bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700">
                                                Deshabilitar
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <form action="/admin/areas/<%= area.idareas %>/rehabilitar" method="post" onsubmit="return confirm('Desea rehabilitar esta area? Volveria a estar disponible en los listados de registro.');">
                                            <button type="submit" class="w-full bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                                                Rehabilitar
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
