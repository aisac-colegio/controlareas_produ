<%- include('partials/header') %>
<!-- Panel del usuario basico. Solo permite registrar visitas. -->
<main class="flex flex-col items-center justify-center">
    <!-- Saludo personalizado tomado de la sesion iniciada. -->
    <h1 class="text-4xl font-bold mt-6 mb-6 text-center md:mt-12">Hola, <%= nombre %></h1>

    <!-- El usuario basico no ve reportes ni administracion; solo este acceso operativo. -->
    <div class="grid grid-cols-1 gap-4 w-full md:w-auto px-4 md:px-0">
        <!-- Abre la pantalla para buscar agremiados y guardar visitas. -->
        <a href="/admin/ingresaragremiado" class="flex justify-center">
            <button type="submit" style="background-color: #1b263d;" class="text-white py-8 px-8 rounded-lg hover:bg-yellow-600 w-full md:w-64 h-48 text-2xl md:text-3xl transition">Registrar Visita</button>
        </a>
    </div>

    <!-- Muestra el rol activo para confirmar los permisos de esta cuenta. -->
    <h3 class="text-xl font-bold mt-6 mb-6 text-center md:mt-12">Rol: <%= role %></h3>
</main>
<%- include('partials/footer') %>
