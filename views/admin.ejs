<%- include('partials/header') %>
<!-- Panel del administrador. Muestra todos los accesos principales del sistema. -->
<main class="flex flex-col items-center justify-center">
    <!-- Saludo personalizado tomado de la sesion iniciada. -->
    <h1 class="text-4xl font-bold mt-6 mb-6 text-center md:mt-12">Hola, <%= nombre %></h1>

    <!-- Cada tarjeta funciona como un boton grande para entrar a una seccion. -->
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4 w-full md:w-auto px-4 md:px-0">
        <!-- Registra una nueva visita de un agremiado. -->
        <a href="/admin/ingresaragremiado" class="flex justify-center">
            <button type="submit" style="background-color: #1b263d;" class="text-white py-8 px-8 rounded-lg hover:bg-yellow-600 w-full md:w-64 h-48 text-2xl md:text-3xl transition">Registrar Visita</button>
        </a>

        <!-- Muestra reportes, graficos y descargas de las visitas. -->
        <a href="/admin/verdatos" class="flex justify-center">
            <button type="submit" style="background-color: #C31B28;" class="bg-[#C31B28] text-white py-8 px-8 rounded-lg hover:bg-purple-700 w-full md:w-64 h-48 text-3xl md:text-4xl transition">Estadísticas</button>
        </a>

        <!-- Administra las areas que aparecen al registrar una visita. -->
        <a href="/admin/areas" class="flex justify-center">
            <button type="submit" style="background-color: #1b263d;" class="text-white py-8 px-8 rounded-lg hover:bg-blue-700 w-full md:w-64 h-48 text-2xl md:text-3xl transition">Áreas</button>
        </a>

        <!-- Administra cuentas, claves y roles de usuarios. -->
        <a href="/admin/usuarios" class="flex justify-center">
            <button type="submit" style="background-color: #C31B28;" class="text-white py-8 px-8 rounded-lg hover:bg-red-800 w-full md:w-64 h-48 text-2xl md:text-3xl transition">Usuarios</button>
        </a>
    </div>

    <!-- Muestra el rol activo para que la persona sepa con que permisos entro. -->
    <h3 class="text-xl font-bold mt-6 mb-6 text-center md:mt-12">Rol: <%= role %></h3>
</main>
<%- include('partials/footer') %>
